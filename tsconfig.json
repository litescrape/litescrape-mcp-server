{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["src", "test"]
}
